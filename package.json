{
  "name": "chipvoice-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.27.0",
  "scripts": {
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "dev": "turbo dev",
    "test:e2e": "node test-e2e.mjs",
    "test:unit": "pnpm --filter chipvoice test:unit",
    "scores:build": "node apps/web/scripts/scores/compile.mjs",
    "scores:check": "node apps/web/scripts/scores/compile.mjs --check",
    "scores:compare": "node apps/web/scripts/scores/compare.mjs",
    "arrangements:check": "node scores/arrangements/test.mjs",
    "arrangements:import": "node scores/arrangements/import.mjs",
    "arrangements:eval": "node scores/arrangements/evaluate.mjs",
    "nsf-corpus:check": "node scores/nsf-corpus/corpus.mjs --json .artifacts/nsf-corpus/report.json",
    "nsf-corpus:sheet": "node scores/nsf-corpus/corpus.mjs --json .artifacts/nsf-corpus/report.json --sheet docs/chips/2a03.md",
    "audio:pull": "node apps/web/scripts/audio-store.mjs pull",
    "audio:check": "node apps/web/scripts/audio-store.mjs check",
    "audio:push": "node apps/web/scripts/audio-store.mjs push"
  },
  "devDependencies": {
    "playwright": "^1.62.1",
    "turbo": "^2.5.0"
  }
}

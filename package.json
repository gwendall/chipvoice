{
  "name": "chipvoice-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.27.0",
  "scripts": {
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "dev": "turbo dev",
    "test:e2e": "node test-e2e.mjs",
    "test:unit": "pnpm --filter chipvoice test:unit",
    "scores:build": "node apps/web/scripts/scores/compile.mjs",
    "scores:check": "node apps/web/scripts/scores/compile.mjs --check",
    "scores:compare": "node apps/web/scripts/scores/compare.mjs",
    "arrangements:check": "node scores/arrangements/test.mjs",
    "arrangements:import": "node scores/arrangements/import.mjs",
    "arrangements:eval": "node scores/arrangements/evaluate.mjs",
    "nsf-corpus:check": "node scores/nsf-corpus/corpus.mjs --json .artifacts/nsf-corpus/report.json",
    "nsf-corpus:sheet": "node scores/nsf-corpus/corpus.mjs --json .artifacts/nsf-corpus/report.json --sheet docs/chips/2a03.md",
    "gbs-corpus:check": "node scores/gbs-corpus/corpus.mjs --json .artifacts/gbs-corpus/report.json",
    "gbs-corpus:sheet": "node scores/gbs-corpus/corpus.mjs --json .artifacts/gbs-corpus/report.json --sheet docs/chips/dmg.md",
    "instruments:build": "node scores/instruments/generate.mjs",
    "instruments:check": "node scores/instruments/check-catalogue.mjs",
    "instruments:test": "node scores/instruments/test-presets.mjs",
    "nsf-export:check": "node scores/nsf-export/corpus.mjs --json .artifacts/nsf-export/report.json",
    "nsf-export:sheet": "node scores/nsf-export/corpus.mjs --json .artifacts/nsf-export/report.json --sheet docs/chips/2a03.md",
    "psid-corpus:check": "node scores/psid-corpus/corpus.mjs --json .artifacts/psid-corpus/report.json",
    "psid-corpus:sheet": "node scores/psid-corpus/corpus.mjs --json .artifacts/psid-corpus/report.json --sheet docs/chips/c64.md",
    "gbs-export:check": "node scores/gbs-export/corpus.mjs --json .artifacts/gbs-export/report.json",
    "gbs-export:sheet": "node scores/gbs-export/corpus.mjs --json .artifacts/gbs-export/report.json --sheet docs/chips/dmg.md",
    "audio:pull": "node apps/web/scripts/audio-store.mjs pull",
    "audio:check": "node apps/web/scripts/audio-store.mjs check",
    "audio:push": "node apps/web/scripts/audio-store.mjs push"
  },
  "devDependencies": {
    "playwright": "^1.62.1",
    "turbo": "^2.5.0"
  }
}

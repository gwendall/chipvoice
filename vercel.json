{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build:playground",
  "outputDirectory": "playground",
  "framework": null,
  "headers": [
    {
      "source": "/chipvoice/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    }
  ]
}

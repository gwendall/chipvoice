{
  "extends": "./tsconfig.json",
  "compilerOptions": { "outDir": "dist", "rootDir": "src" },
  "include": ["src"],
  // The worklet is bundled into a string by scripts/build-worklet.mjs and
  // registers a processor the moment it runs. It is type-checked with the
  // rest of src by tsconfig.json; it has no business in dist.
  "exclude": ["src/chips/nes/worklet.ts"]
}

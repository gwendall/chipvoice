# Server-only composition settings. Copy into .env.local and supply your own key.
# Which provider generates songs from a prompt; only "openai" exists today.
COMPOSITION_PROVIDER=openai
# Required to enable composition at all; unset disables it with a clear error.
OPENAI_API_KEY=
# Model id sent to the Responses API.
OPENAI_MODEL=gpt-6-astra
# Reasoning effort hint passed to the model.
OPENAI_REASONING_EFFORT=medium
# Upper bound on generated tokens per composition request.
OPENAI_MAX_OUTPUT_TOKENS=24000
# Per-day composition cap, enforced server-side.
COMPOSITION_DAILY_LIMIT=10
# Who may compose (decision 42): "invite" (accounts listed by
# scripts/composition-invites.mjs) or "open". Unset, it is "invite" on Vercel
# and "open" on your machine.
# COMPOSITION_ACCESS=open
# Monthly spend cap in USD, priced from recorded token usage. Required in
# production, where composition stops without it; optional elsewhere.
# COMPOSITION_MONTHLY_BUDGET_USD=110
# Prices in USD per million tokens, only for a model the server has no price
# for (gpt-6-astra is built in).
# COMPOSITION_USD_PER_MILLION_INPUT=
# COMPOSITION_USD_PER_MILLION_CACHED_INPUT=
# COMPOSITION_USD_PER_MILLION_OUTPUT=
# Optional server-controlled override; defaults to the direct OpenAI API.
# OPENAI_BASE_URL=https://api.openai.com/v1/

# Server-only sign-in email. Use a dedicated Domani token restricted to this mailbox.
# Required for magic-link sign-in email; unset disables sending it.
DOMANI_API_KEY=
# From address on outgoing sign-in email.
CHIPVOICE_MAIL_FROM=hello@chipvoice.dev
# Optional Domani API override; defaults to the hosted service.
# DOMANI_BASE_URL=https://domani.run

# Canonical site origin used to build absolute links (share URLs, email).
# Needed locally only if you want those links to point elsewhere than the
# production default.
# NEXT_PUBLIC_SITE_URL=https://chipvoice.dev

# Bearer token that unlocks the admin song endpoints (lineage, soft-delete).
# Optional locally: those endpoints just stay disabled without it.
# CHIPVOICE_ADMIN_KEY=

# Production database (Turso/libSQL). VERCEL_ENV is set automatically by
# Vercel; do not set it yourself. Without a database, the app falls back to a
# local SQLite file (.chipvoice-dev.db), so none of these four are needed for
# ordinary local development.
# TURSO_DATABASE_URL=
# TURSO_AUTH_TOKEN=
# Optional: point local/preview runs at a shared remote dev database instead
# of the local SQLite file. Both of the next two are required together.
# TURSO_DEV_DATABASE_URL=
# TURSO_DEV_AUTH_TOKEN=

# The following are read by one-off scripts in apps/web/scripts, passed
# inline on the command line for a single run (e.g. `SITE=... MODE=live node
# scripts/diagnose-interaction-latency.mjs`). Not needed in .env.local.
# SITE: base URL the script drives; defaults to https://chipvoice.dev.
# MODE: landing, live, create or lab (diagnose-interaction-latency.mjs).
# ENFORCE_WARM=1: fail the run if warm selection exceeds its latency budget.
# WARM_ONLY=1: skip the cold-selection measurements.
# CHIPVOICE_EVAL_PRODUCTION=1: required opt-in for eval-human-signin.mjs,
#   which sends real email through production.
# CHIPVOICE_EVAL_SECONDS: requested song length for eval-human-signin.mjs.

{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "types": ["node", "vite/client"],
    "paths": { "chipvoice": ["../../packages/chipvoice/dist/index.d.ts"] }
  },
  "include": ["src", "vite.config.ts"]
}
